{
  "name": "linzi-song-stage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "林子的实时点歌台",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:cf": "node scripts/build-cloudflare-seed.mjs && vite build",
    "deploy:cf": "npm run build:cf && npx wrangler deploy",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.3"
  }
}
